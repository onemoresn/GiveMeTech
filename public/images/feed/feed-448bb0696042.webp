<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 440" role="img" aria-labelledby="title desc">
  <title id="title">Release change timeline</title><desc id="desc">Three bright seams mark material changes cutting through quiet strata.</desc>
  <defs><linearGradient id="bg" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#09111d"/><stop offset="1" stop-color="#17142b"/></linearGradient><filter id="glow"><feGaussianBlur stdDeviation="12"/></filter></defs>
  <style>.seam{stroke-dasharray:230;stroke-dashoffset:230;animation:cut 3s ease-out forwards}.s2{animation-delay:.5s}.s3{animation-delay:1s}@keyframes cut{to{stroke-dashoffset:0}}.pulse{animation:pulse 2.8s ease-in-out infinite}@keyframes pulse{50%{opacity:1}}</style>
  <rect width="1000" height="440" rx="24" fill="url(#bg)"/><rect x="56" y="54" width="888" height="332" rx="18" fill="#0b1220" stroke="#334155" stroke-width="2"/>
  <text x="92" y="100" fill="#cbd5e1" font-family="ui-monospace,monospace" font-size="16">RELEASE SIGNAL TIMELINE</text>
  <g fill="none" stroke="#334155" stroke-width="5"><path d="M108 150C280 134 375 165 520 149S755 134 892 154"/><path d="M108 190C280 174 375 205 520 189S755 174 892 194"/><path d="M108 230C280 214 375 245 520 229S755 214 892 234"/><path d="M108 270C280 254 375 285 520 269S755 254 892 274"/><path d="M108 310C280 294 375 325 520 309S755 294 892 314"/></g>
  <g class="pulse" opacity=".55" stroke="#818cf8" stroke-width="22" filter="url(#glow)"><path d="M286 126v210"/><path d="M506 126v210"/><path d="M726 126v210"/></g>
  <g class="seam" fill="none" stroke="#5eead4" stroke-width="5"><path d="M286 126v210"/><path class="s2" d="M506 126v210"/><path class="s3" d="M726 126v210"/></g>
  <g fill="#5eead4"><circle cx="286" cy="126" r="7"/><circle cx="506" cy="126" r="7"/><circle cx="726" cy="126" r="7"/></g><path d="M108 348h784" stroke="#475569" stroke-width="2" stroke-dasharray="5 10"/>
</svg>
