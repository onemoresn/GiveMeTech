<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 428" width="720" height="428" font-family="IBM Plex Sans, -apple-system, Segoe UI, Helvetica, Arial, sans-serif" role="img">
<rect width="720" height="428" fill="#ffffff"/>
<text x="32" y="50" font-size="28" font-weight="600" fill="#0d2b45">Cost per task by effort level</text>
<text x="32" y="86" font-size="20" font-weight="400" fill="#4a6580">USD per coding task, one model, vendor benchmark.</text>
<text x="32" y="144" font-size="22" fill="#0d2b45">Low effort: 87.4% solved</text><text x="688" y="144" font-size="22" font-weight="600" text-anchor="end" fill="#0d2b45">0.11</text><rect x="32" y="156" width="249" height="18" fill="#0d2b45"/>
<text x="32" y="212" font-size="22" fill="#0d2b45">Medium effort: 92.8% solved</text><text x="688" y="212" font-size="22" font-weight="600" text-anchor="end" fill="#0d2b45">0.21</text><rect x="32" y="224" width="475" height="18" fill="#0d2b45"/>
<text x="32" y="280" font-size="22" fill="#0d2b45">High effort: 95.3% solved</text><text x="688" y="280" font-size="22" font-weight="600" text-anchor="end" fill="#0d2b45">0.29</text><rect x="32" y="292" width="656" height="18" fill="#0d2b45"/>
<text x="32" y="348" font-size="22" fill="#0d2b45">Low, failures retried at high: about 97%</text><text x="688" y="348" font-size="22" font-weight="600" text-anchor="end" fill="#0d2b45">0.17</text><rect x="32" y="360" width="385" height="18" fill="#ff7a1a"/>
<text x="688" y="420" font-size="13" text-anchor="end" fill="#4a6580">madsalt.tech</text>
</svg>
