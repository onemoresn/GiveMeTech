<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 440" role="img" aria-labelledby="title description">
  <title id="title">Repository signal assessment</title>
  <desc id="description">A GitHub repository is assessed through activity, maintenance, contribution, and release signals.</desc>
  <defs>
    <linearGradient id="background" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#09111d"/><stop offset="1" stop-color="#131125"/></linearGradient>
    <linearGradient id="score" x1="0" y1="1" x2="1" y2="0"><stop stop-color="#5eead4"/><stop offset="1" stop-color="#818cf8"/></linearGradient>
    <filter id="glow"><feGaussianBlur stdDeviation="8"/></filter>
  </defs>
  <style>
    .scan { animation: scan 3.6s ease-in-out infinite; }
    .pulse { animation: pulse 2.4s ease-in-out infinite; transform-origin: center; }
    .bar { animation: rise 1.1s ease-out both; transform-origin: bottom; }
    .b2 { animation-delay: .12s }.b3 { animation-delay: .24s }.b4 { animation-delay: .36s }
    @keyframes scan { 0%,100% { transform: translateX(-12px); opacity:.2 } 45%,55% { opacity:1 } 50% { transform:translateX(560px); opacity:1 } }
    @keyframes pulse { 0%,100% { opacity:.45; transform:scale(.94) } 50% { opacity:1; transform:scale(1.04) } }
    @keyframes rise { from { transform:scaleY(.08); opacity:0 } to { transform:scaleY(1); opacity:1 } }
  </style>
  <rect width="1000" height="440" rx="24" fill="url(#background)"/>
  <path d="M48 70H952M48 370H952" stroke="#334155" stroke-width="2"/>
  <g fill="#64748b"><circle cx="66" cy="52" r="5"/><circle cx="86" cy="52" r="5"/><circle cx="106" cy="52" r="5"/></g>
  <text x="130" y="59" fill="#cbd5e1" font-family="ui-monospace, monospace" font-size="16">REPOSITORY SIGNAL CHECK</text>
  <rect x="74" y="96" width="420" height="232" rx="18" fill="#0f172a" stroke="#334155" stroke-width="2"/>
  <g transform="translate(108 130)">
    <path d="M0 25a25 25 0 0 1 50 0v17a12 12 0 0 1-12 12H12A12 12 0 0 1 0 42Z" fill="#172554" stroke="#818cf8" stroke-width="3"/>
    <circle cx="15" cy="25" r="4" fill="#5eead4"/><circle cx="35" cy="25" r="4" fill="#5eead4"/>
    <path d="M18 40h14" stroke="#cbd5e1" stroke-width="3" stroke-linecap="round"/>
  </g>
  <text x="178" y="151" fill="#f8fafc" font-family="system-ui, sans-serif" font-size="25" font-weight="700">Assess before you adopt</text>
  <text x="178" y="181" fill="#94a3b8" font-family="system-ui, sans-serif" font-size="16">Turn repository evidence into a decision.</text>
  <g transform="translate(110 220)">
    <rect width="92" height="14" rx="7" fill="#1e293b"/><rect class="bar" width="78" height="14" rx="7" fill="#5eead4"/>
    <text x="112" y="13" fill="#cbd5e1" font-family="ui-monospace, monospace" font-size="14">recent commits</text>
    <rect y="34" width="92" height="14" rx="7" fill="#1e293b"/><rect class="bar b2" width="62" height="14" rx="7" fill="#818cf8"/>
    <text x="112" y="47" fill="#cbd5e1" font-family="ui-monospace, monospace" font-size="14">issue response</text>
    <rect y="68" width="92" height="14" rx="7" fill="#1e293b"/><rect class="bar b3" width="84" height="14" rx="7" fill="#5eead4"/>
    <text x="112" y="81" fill="#cbd5e1" font-family="ui-monospace, monospace" font-size="14">release cadence</text>
  </g>
  <g transform="translate(566 105)">
    <circle cx="154" cy="112" r="100" fill="#818cf8" opacity=".12" filter="url(#glow)"/>
    <circle cx="154" cy="112" r="89" fill="#0f172a" stroke="#475569" stroke-width="2"/>
    <circle class="pulse" cx="154" cy="112" r="65" fill="none" stroke="url(#score)" stroke-width="13" stroke-dasharray="316 95" transform="rotate(-90 154 112)"/>
    <text x="154" y="107" text-anchor="middle" fill="#f8fafc" font-family="system-ui, sans-serif" font-size="42" font-weight="700">82</text>
    <text x="154" y="132" text-anchor="middle" fill="#94a3b8" font-family="ui-monospace, monospace" font-size="14">SIGNAL</text>
    <g stroke="#5eead4" fill="none" stroke-width="3"><path d="M28 212h30l18-28 24 48 29-68 20 48h35"/><circle cx="149" cy="212" r="5" fill="#5eead4"/></g>
    <rect class="scan" x="28" y="246" width="4" height="44" rx="2" fill="#5eead4"/>
    <path d="M28 268h258" stroke="#334155" stroke-width="2"/>
  </g>
  <path d="M74 348H926" stroke="#334155" stroke-width="2" stroke-dasharray="4 10"/>
</svg>
