<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 376" width="720" height="376" font-family="IBM Plex Sans, -apple-system, Segoe UI, Helvetica, Arial, sans-serif" role="img">
<rect width="720" height="376" fill="#ffffff"/>
<text x="32" y="50" font-size="28" font-weight="600" fill="#0d2b45">Who guards each step of a request</text>
<text x="32" y="86" font-size="20" font-weight="400" fill="#4a6580">Supabase runs the transport and the keys; grants and</text>
<text x="32" y="112" font-size="20" font-weight="400" fill="#4a6580">policies are yours.</text>
<text x="32" y="170" font-size="22" font-weight="600" fill="#0d2b45">From a browser</text><rect x="32" y="184" width="95" height="40" fill="#eef3f8" stroke="#0d2b45" stroke-width="1.5"/><text x="79.5" y="210" font-size="18" text-anchor="middle" fill="#0d2b45">Browser</text><line x1="127" y1="204" x2="153" y2="204" stroke="#0d2b45" stroke-width="2"/><path d="M146 199 L155 204 L146 209 Z" fill="#0d2b45"/><rect x="155" y="184" width="216" height="40" fill="#eef3f8" stroke="#0d2b45" stroke-width="1.5"/><text x="263" y="210" font-size="18" text-anchor="middle" fill="#0d2b45">TLS, key · Supabase</text><line x1="371" y1="204" x2="397" y2="204" stroke="#0d2b45" stroke-width="2"/><path d="M390 199 L399 204 L390 209 Z" fill="#0d2b45"/><rect x="399" y="184" width="135" height="40" fill="#eef3f8" stroke="#0d2b45" stroke-width="1.5"/><text x="466.5" y="210" font-size="18" text-anchor="middle" fill="#0d2b45">Grant · you</text><line x1="534" y1="204" x2="560" y2="204" stroke="#0d2b45" stroke-width="2"/><path d="M553 199 L562 204 L553 209 Z" fill="#0d2b45"/><rect x="562" y="184" width="115" height="40" fill="#eef3f8" stroke="#0d2b45" stroke-width="1.5"/><text x="619.5" y="210" font-size="18" text-anchor="middle" fill="#0d2b45">RLS · you</text>
<text x="32" y="274" font-size="22" font-weight="600" fill="#0d2b45">From your server</text><rect x="32" y="288" width="85" height="40" fill="#eef3f8" stroke="#0d2b45" stroke-width="1.5"/><text x="74.5" y="314" font-size="18" text-anchor="middle" fill="#0d2b45">Server</text><line x1="117" y1="308" x2="143" y2="308" stroke="#0d2b45" stroke-width="2"/><path d="M136 303 L145 308 L136 313 Z" fill="#0d2b45"/><rect x="145" y="288" width="166" height="40" fill="#eef3f8" stroke="#0d2b45" stroke-width="1.5"/><text x="228" y="314" font-size="18" text-anchor="middle" fill="#0d2b45">TLS · Supabase</text><line x1="311" y1="308" x2="337" y2="308" stroke="#0d2b45" stroke-width="2"/><path d="M330 303 L339 308 L330 313 Z" fill="#0d2b45"/><rect x="339" y="288" width="186" height="40" fill="#eef3f8" stroke="#0d2b45" stroke-width="1.5"/><text x="432" y="314" font-size="18" text-anchor="middle" fill="#0d2b45">Secret key · you</text><line x1="525" y1="308" x2="551" y2="308" stroke="#0d2b45" stroke-width="2"/><path d="M544 303 L553 308 L544 313 Z" fill="#0d2b45"/><rect x="553" y="288" width="135" height="40" fill="#eef3f8" stroke="#0d2b45" stroke-width="1.5"/><text x="620.5" y="314" font-size="18" text-anchor="middle" fill="#0d2b45">RLS skipped</text>
<text x="688" y="368" font-size="13" text-anchor="end" fill="#4a6580">madsalt.tech</text>
