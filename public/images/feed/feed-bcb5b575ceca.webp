<svg xmlns="http://www.w3.org/2000/svg" width="960" height="460" viewBox="0 0 960 460" role="img" aria-labelledby="title desc">
  <title id="title">Named model: identity and egress first</title>
  <desc id="desc">Four stages for Foundry webapp deploy: reuse the identity plane, design private egress, run secretless OBO as the right managed identity, then prove DNS and roles before prompts.</desc>
  <rect width="960" height="460" fill="#f8fafc"/>
  <defs>
    <marker id="arrowNavy" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" fill="#0369a1"/>
    </marker>
  </defs>
  <text x="480" y="32" text-anchor="middle" font-family="Inter, Helvetica, Arial, sans-serif" font-size="18" font-weight="700" fill="#0c4a6e">Named model: identity and egress first</text>
  <text x="480" y="54" text-anchor="middle" font-family="Inter, Helvetica, Arial, sans-serif" font-size="13" fill="#0369a1">container hostname is table stakes · the plane is the product</text>

  <rect x="24" y="84" width="210" height="230" rx="16" fill="#ffffff" stroke="#0ea5e9" stroke-width="2"/>
  <circle cx="54" cy="114" r="14" fill="#e0f2fe" stroke="#0284c7" stroke-width="1.5"/>
  <text x="54" y="119" text-anchor="middle" font-family="Inter, Helvetica, Arial, sans-serif" font-size="12" font-weight="700" fill="#0c4a6e">1</text>
  <text x="129" y="120" text-anchor="middle" font-family="Inter, Helvetica, Arial, sans-serif" font-size="15" font-weight="700" fill="#0c4a6e">Identity</text>
  <text x="129" y="156" text-anchor="middle" font-family="Inter, Helvetica, Arial, sans-serif" font-size="13" fill="#0369a1">UAMI + Entra apps</text>
  <text x="129" y="182" text-anchor="middle" font-family="Inter, Helvetica, Arial, sans-serif" font-size="12" fill="#64748b">reuse ACR · Insights</text>
  <text x="129" y="208" text-anchor="middle" font-family="Inter, Helvetica, Arial, sans-serif" font-size="12" fill="#64748b">one plane, mapped</text>
  <text x="129" y="260" text-anchor="middle" font-family="Inter, Helvetica, Arial, sans-serif" font-size="12" font-weight="600" fill="#0284c7">who the app runs as</text>

  <line x1="244" y1="199" x2="268" y2="199" stroke="#0369a1" stroke-width="2.5" marker-end="url(#arrowNavy)"/>

  <rect x="276" y="84" width="210" height="230" rx="16" fill="#ffffff" stroke="#0ea5e9" stroke-width="2"/>
  <circle cx="306" cy="114" r="14" fill="#e0f2fe" stroke="#0284c7" stroke-width="1.5"/>
  <text x="306" y="119" text-anchor="middle" font-family="Inter, Helvetica, Arial, sans-serif" font-size="12" font-weight="700" fill="#0c4a6e">2</text>
  <text x="381" y="120" text-anchor="middle" font-family="Inter, Helvetica, Arial, sans-serif" font-size="15" font-weight="700" fill="#0c4a6e">Egress</text>
  <text x="381" y="156" text-anchor="middle" font-family="Inter, Helvetica, Arial, sans-serif" font-size="13" fill="#0369a1">VNet integration</text>
  <text x="381" y="182" text-anchor="middle" font-family="Inter, Helvetica, Arial, sans-serif" font-size="12" fill="#64748b">private endpoints</text>
  <text x="381" y="208" text-anchor="middle" font-family="Inter, Helvetica, Arial, sans-serif" font-size="12" fill="#64748b">private DNS linked</text>
  <text x="381" y="260" text-anchor="middle" font-family="Inter, Helvetica, Arial, sans-serif" font-size="12" font-weight="600" fill="#0284c7">how it reaches deps</text>

  <line x1="496" y1="199" x2="520" y2="199" stroke="#0369a1" stroke-width="2.5" marker-end="url(#arrowNavy)"/>

  <rect x="528" y="84" width="210" height="230" rx="16" fill="#ffffff" stroke="#0284c7" stroke-width="2"/>
  <circle cx="558" cy="114" r="14" fill="#bae6fd" stroke="#0284c7" stroke-width="1.5"/>
  <text x="558" y="119" text-anchor="middle" font-family="Inter, Helvetica, Arial, sans-serif" font-size="12" font-weight="700" fill="#0c4a6e">3</text>
  <text x="633" y="120" text-anchor="middle" font-family="Inter, Helvetica, Arial, sans-serif" font-size="15" font-weight="700" fill="#0c4a6e">OBO</text>
  <text x="633" y="156" text-anchor="middle" font-family="Inter, Helvetica, Arial, sans-serif" font-size="13" fill="#0369a1">secretless tokens</text>
  <text x="633" y="182" text-anchor="middle" font-family="Inter, Helvetica, Arial, sans-serif" font-size="12" fill="#64748b">right MI + audience</text>
  <text x="633" y="208" text-anchor="middle" font-family="Inter, Helvetica, Arial, sans-serif" font-size="12" fill="#64748b">API permissions</text>
  <text x="633" y="260" text-anchor="middle" font-family="Inter, Helvetica, Arial, sans-serif" font-size="12" font-weight="600" fill="#0284c7">auth before prompts</text>

  <line x1="748" y1="199" x2="772" y2="199" stroke="#0369a1" stroke-width="2.5" marker-end="url(#arrowNavy)"/>

  <rect x="780" y="84" width="156" height="230" rx="16" fill="#0ea5e9"/>
  <circle cx="808" cy="114" r="14" fill="#0284c7"/>
  <text x="808" y="119" text-anchor="middle" font-family="Inter, Helvetica, Arial, sans-serif" font-size="12" font-weight="700" fill="#ffffff">4</text>
  <text x="858" y="120" text-anchor="middle" font-family="Inter, Helvetica, Arial, sans-serif" font-size="15" font-weight="700" fill="#ffffff">Prove</text>
  <text x="858" y="156" text-anchor="middle" font-family="Inter, Helvetica, Arial, sans-serif" font-size="13" fill="#e0f2fe">DNS · roles</text>
  <text x="858" y="182" text-anchor="middle" font-family="Inter, Helvetica, Arial, sans-serif" font-size="12" fill="#bae6fd">OBO path</text>
  <text x="858" y="208" text-anchor="middle" font-family="Inter, Helvetica, Arial, sans-serif" font-size="12" fill="#bae6fd">then evals</text>
  <text x="858" y="260" text-anchor="middle" font-family="Inter, Helvetica, Arial, sans-serif" font-size="12" font-weight="600" fill="#ffffff">plane first</text>

  <rect x="24" y="344" width="912" height="88" rx="14" fill="#e0f2fe" stroke="#0284c7" stroke-width="1.5"/>
  <text x="480" y="380" text-anchor="middle" font-family="Inter, Helvetica, Arial, sans-serif" font-size="15" font-weight="700" fill="#0c4a6e">A Foundry webapp is an identity and egress design that happens to run a container</text>
  <text x="480" y="408" text-anchor="middle" font-family="Inter, Helvetica, Arial, sans-serif" font-size="13" fill="#0369a1">Ingress posture is a separate product decision. Do not mix it into the egress diagram.</text>
</svg>
