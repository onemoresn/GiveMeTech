<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 520" role="img" aria-labelledby="title desc">
  <title id="title">Stable prefix and changing suffix cache path</title>
  <desc id="desc">Repeated dark blocks enter a transparent cache chamber while changing lime and gray blocks bypass the reusable prefix.</desc>
  <defs>
    <linearGradient id="paper" x1="0" x2="1" y1="0" y2="1">
      <stop offset="0" stop-color="#fbfaf5"/>
      <stop offset="1" stop-color="#f1eee5"/>
    </linearGradient>
    <linearGradient id="glass" x1="0" x2="1" y1="0" y2="1">
      <stop offset="0" stop-color="#ffffff" stop-opacity=".72"/>
      <stop offset="1" stop-color="#dce6df" stop-opacity=".22"/>
    </linearGradient>
    <filter id="shadow" x="-20%" y="-30%" width="140%" height="170%">
      <feDropShadow dx="0" dy="12" stdDeviation="14" flood-color="#17221d" flood-opacity=".14"/>
    </filter>
    <marker id="arrow" markerWidth="12" markerHeight="12" refX="9" refY="6" orient="auto">
      <path d="M0 0L12 6L0 12Z" fill="#1e2723"/>
    </marker>
  </defs>
  <rect width="1200" height="520" rx="34" fill="url(#paper)"/>
  <path d="M70 125H1110M70 395H1110" stroke="#1e2723" stroke-opacity=".12" stroke-width="2"/>
  <g filter="url(#shadow)">
    <rect x="370" y="82" width="440" height="356" rx="30" fill="url(#glass)" stroke="#1e2723" stroke-width="4"/>
    <path d="M405 125H775M405 395H775" stroke="#8faaa0" stroke-width="3" stroke-dasharray="10 12"/>
    <path d="M595 82V438" stroke="#1e2723" stroke-opacity=".16" stroke-width="2"/>
    <circle cx="595" cy="260" r="106" fill="none" stroke="#c6d7cf" stroke-width="2" stroke-dasharray="6 12"/>
    <circle cx="595" cy="260" r="70" fill="#d8f33e" fill-opacity=".22" stroke="#a7c81b" stroke-width="3"/>
  </g>
  <g fill="#1e2723">
    <rect x="82" y="188" width="64" height="64" rx="12"/>
    <rect x="162" y="188" width="64" height="64" rx="12"/>
    <rect x="242" y="188" width="64" height="64" rx="12"/>
    <rect x="82" y="294" width="64" height="64" rx="12"/>
    <rect x="162" y="294" width="64" height="64" rx="12"/>
    <rect x="242" y="294" width="64" height="64" rx="12"/>
  </g>
  <g fill="#d8f33e" stroke="#a7c81b" stroke-width="2">
    <rect x="878" y="188" width="64" height="64" rx="12"/>
    <rect x="958" y="188" width="64" height="64" rx="12"/>
    <rect x="1038" y="188" width="64" height="64" rx="12"/>
  </g>
  <g fill="#727c76" opacity=".72">
    <rect x="878" y="294" width="64" height="64" rx="12"/>
    <rect x="958" y="294" width="64" height="64" rx="12"/>
    <rect x="1038" y="294" width="64" height="64" rx="12"/>
  </g>
  <g stroke="#1e2723" stroke-width="5" fill="none" marker-end="url(#arrow)">
    <path d="M306 220H354"/>
    <path d="M306 326H354"/>
    <path d="M836 220H866"/>
    <path d="M836 326H866"/>
  </g>
  <path d="M468 260H722" stroke="#a7c81b" stroke-width="10" stroke-linecap="round" stroke-dasharray="4 24"/>
  <path d="M595 154V366" stroke="#a7c81b" stroke-width="6" stroke-linecap="round" stroke-dasharray="3 18"/>
</svg>
