 transition-opacity duration-300 group-hover:opacity-100"></div><div class="z-10 shrink-0"><div class="rounded-md bg-primary/10 p-1.5 text-primary shadow-sm shadow-primary/20 transition-colors duration-300 group-hover:bg-primary group-hover:text-black"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check-big h-4 w-4"><path d="M21.801 10A10 10 0 1117 3.335"/><path d="m9 11 3 3L22 4"/></svg></div></div><div class="z-10 flex w-full flex-col"><h3 class="text-[16px] font-semibold text-white transition-colors duration-300 group-hover:text-primary">Business SEO</h3><p class="text-[15px] leading-tight text-white/65 transition-colors group-hover:text-white/80">Build strong service pages, content strategy, and organic lead generation systems for long-term growth.</p><a href=/business-seo class="z-20 mt-1.5 inline-flex w-fit cursor-pointer items-center gap-1 text-[13px] text-primary transition-colors hover:underline">Learn More<span class="inline-block transition-transform group-hover:translate-x-0.5">→</span></a></div></div><div class="group relative flex cursor-default items-center gap-3 overflow-hidden rounded-xl border border-white/10 bg-white/[0.03] p-3 backdrop-blur-md transition-all duration-300 hover:border-primary/50 hover:bg-white/[0.05]"><div class="absolute -inset-1 bg-gradient-to-r from-primary/10 to-transparent opacity-0 blur-md transition-opacity duration-300 group-hover:opacity-100"></div><div class="z-10 shrink-0"><div class="rounded-md bg-primary/10 p-1.5 text-primary shadow-sm shadow-primary/20 transition-colors duration-300 group-hover:bg-primary group-hover:text-black"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check-big h-4 w-4"><path d="M21.801 10A10 10 0 1117 3.335"/><path d="m9 11 3 3L22 4"/></svg><