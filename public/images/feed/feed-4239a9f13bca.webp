<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 630" width="1200" height="630">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1a1a2e"/>
      <stop offset="100%" style="stop-color:#16213e"/>
    </linearGradient>
    <linearGradient id="card1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#e94560"/>
      <stop offset="100%" style="stop-color:#c23152"/>
    </linearGradient>
    <linearGradient id="card2" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0f3460"/>
      <stop offset="100%" style="stop-color:#1a5276"/>
    </linearGradient>
    <linearGradient id="card3" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#533483"/>
      <stop offset="100%" style="stop-color:#3d2466"/>
    </linearGradient>
    <linearGradient id="card4" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0e6655"/>
      <stop offset="100%" style="stop-color:#0b5345"/>
    </linearGradient>
    <linearGradient id="card5" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#d35400"/>
      <stop offset="100%" style="stop-color:#a04000"/>
    </linearGradient>
  </defs>

  <!-- Background -->
  <rect width="1200" height="630" fill="url(#bg)"/>

  <!-- Grid pattern -->
  <g opacity="0.03">
    <line x1="0" y1="0" x2="1200" y2="0" stroke="white" stroke-width="0.5"/>
    <line x1="0" y1="126" x2="1200" y2="126" stroke="white" stroke-width="0.5"/>
    <line x1="0" y1="252" x2="1200" y2="252" stroke="white" stroke-width="0.5"/>
    <line x1="0" y1="378" x2="1200" y2="378" stroke="white" stroke-width="0.5"/>
    <line x1="0" y1="504" x2="1200" y2="504" stroke="white" stroke-width="0.5"/>
    <line x1="0" y1="630" x2="1200" y2="630" stroke="white" stroke-width="0.5"/>
    <line x1="0" y1="0" x2="0" y2="630" stroke="white" stroke-width="0.5"/>
    <line x1="240" y1="0" x2="240" y2="630" stroke="white" stroke-width="0.5"/>
    <line x1="480" y1="0" x2="480" y2="630" stroke="white" stroke-width="0.5"/>
    <line x1="720" y1="0" x2="720" y2="630" stroke="white" stroke-width="0.5"/>
    <line x1="960" y1="0" x2="960" y2="630" stroke="white" stroke-width="0.5"/>
    <line x1="1200" y1="0" x2="1200" y2="630" stroke="white" stroke-width="0.5"/>
  </g>

  <!-- Title -->
  <text x="600" y="65" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="28" font-weight="700" fill="#ffffff">AI Industry This Week</text>
  <text x="600" y="98" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="16" fill="#8899aa">August 3 - 7, 2026</text>

  <!-- Card 1: Kitesurf - top left -->
  <rect x="40" y="125" width="350" height="145" rx="12" fill="url(#card1)" opacity="0.9"/>
  <circle cx="75" cy="162" r="18" fill="rgba(255,255,255,0.2)"/>
  <text x="75" y="168" text-anchor="middle" font-family="system-ui, sans-serif" font-size="18" fill="white">🌐</text>
  <text x="105" y="166" font-family="system-ui, sans-serif" font-size="18" font-weight="600" fill="white">Cloudflare Kitesurf</text>
  <text x="60" y="195" font-family="system-ui, sans-serif" font-size="13" fill="rgba(255,255,255,0.85)">A browser built for AI agents.</text>
  <text x="60" y="215" font-family="system-ui, sans-serif" font-size="13" fill="rgba(255,255,255,0.85)">Rust/Wasm on Workers, 3-7x less</text>
  <text x="60" y="235" font-family="system-ui, sans-serif" font-size="13" fill="rgba(255,255,255,0.85)">memory than Chromium. Free beta.</text>
  <rect x="60" y="248" width="90" height="18" rx="9" fill="rgba(255,255,255,0.15)"/>
  <text x="105" y="260" text-anchor="middle" font-family="system-ui, sans-serif" font-size="10" fill="rgba(255,255,255,0.7)">Aug 6</text>

  <!-- Card 2: Agent Plugins - top middle -->
  <rect x="425" y="125" width="350" height="145" rx="12" fill="url(#card2)" opacity="0.9"/>
  <circle cx="460" cy="162" r="18" fill="rgba(255,255,255,0.2)"/>
  <text x="460" y="168" text-anchor="middle" font-family="system-ui, sans-serif" font-size="18" fill="white">🔌</text>
  <text x="490" y="166" font-family="system-ui, sans-serif" font-size="18" font-weight="600" fill="white">Agent Plugins 1.0</text>
  <text x="445" y="195" font-family="system-ui, sans-serif" font-size="13" fill="rgba(255,255,255,0.85)">Amazon, Microsoft, OpenAI, Cursor,</text>
  <text x="445" y="215" font-family="system-ui, sans-serif" font-size="13" fill="rgba(255,255,255,0.85)">and Vercel unite on one packaging</text>
  <text x="445" y="235" font-family="system-ui, sans-serif" font-size="13" fill="rgba(255,255,255,0.85)">standard for AI agent extensions.</text>
  <rect x="445" y="248" width="90" height="18" rx="9" fill="rgba(255,255,255,0.15)"/>
  <text x="490" y="260" text-anchor="middle" font-family="system-ui, sans-serif" font-size="10" fill="rgba(255,255,255,0.7)">Aug 6</text>

  <!-- Card 3: OpenAI Astra - top right -->
  <rect x="810" y="125" width="350" height="145" rx="12" fill="url(#card3)" opacity="0.9"/>
  <circle cx="845" cy="162" r="18" fill="rgba(255,255,255,0.2)"/>
  <text x="845" y="168" text-anchor="middle" font-family="system-ui, sans-serif" font-size="18" fill="white">⚠️</text>
  <text x="875" y="166" font-family="system-ui, sans-serif" font-size="18" font-weight="600" fill="white">OpenAI Pauses Astra</text>
  <text x="830" y="195" font-family="system-ui, sans-serif" font-size="13" fill="rgba(255,255,255,0.85)">Astra triggered the highest</text>
  <text x="830" y="215" font-family="system-ui, sans-serif" font-size="13" fill="rgba(255,255,255,0.85)">cybersecurity risk tier. OpenAI</text>
  <text x="830" y="235" font-family="system-ui, sans-serif" font-size="13" fill="rgba(255,255,255,0.85)">expands safety testing.</text>
  <rect x="830" y="248" width="90" height="18" rx="9" fill="rgba(255,255,255,0.15)"/>
  <text x="875" y="260" text-anchor="middle" font-family="system-ui, sans-serif" font-size="10" fill="rgba(255,255,255,0.7)">This week</text>

  <!-- Card 4: ByteDance - bottom left -->
  <rect x="40" y="300" width="350" height="145" rx="12" fill="url(#card4)" opacity="0.9"/>
  <circle cx="75" cy="337" r="18" fill="rgba(255,255,255,0.2)"/>
  <text x="75" y="343" text-anchor="middle" font-family="system-ui, sans-serif" font-size="18" fill="white">🏗️</text>
  <text x="105" y="341" font-family="system-ui, sans-serif" font-size="18" font-weight="600" fill="white">ByteDance AI Model</text>
  <text x="60" y="370" font-family="system-ui, sans-serif" font-size="13" fill="rgba(255,255,255,0.85)">China's largest tech company is</text>
  <text x="60" y="390" font-family="system-ui, sans-serif" font-size="13" fill="rgba(255,255,255,0.85)">training a massive model to rival</text>
  <text x="60" y="410" font-family="system-ui, sans-serif" font-size="13" fill="rgba(255,255,255,0.85)">Anthropic and OpenAI.</text>
  <rect x="60" y="423" width="90" height="18" rx="9" fill="rgba(255,255,255,0.15)"/>
  <text x="105" y="435" text-anchor="middle" font-family="system-ui, sans-serif" font-size="10" fill="rgba(255,255,255,0.7)">This week</text>

  <!-- Card 5: Anthropic Hardware - bottom middle -->
  <rect x="425" y="300" width="350" height="145" rx="12" fill="url(#card5)" opacity="0.9"/>
  <circle cx="460" cy="337" r="18" fill="rgba(255,255,255,0.2)"/>
  <text x="460" y="343" text-anchor="middle" font-family="system-ui, sans-serif" font-size="18" fill="white">💾</text>
  <text x="490" y="341" font-family="system-ui, sans-serif" font-size="18" font-weight="600" fill="white">Anthropic Hardware</text>
  <text x="445" y="370" font-family="system-ui, sans-serif" font-size="13" fill="rgba(255,255,255,0.85)">Anthropic will design custom silicon</text>
  <text x="445" y="390" font-family="system-ui, sans-serif" font-size="13" fill="rgba(255,255,255,0.85)">to power Claude, following the</text>
  <text x="445" y="410" font-family="system-ui, sans-serif" font-size="13" fill="rgba(255,255,255,0.85)">Google TPU and AWS Trainium path.</text>
  <rect x="445" y="423" width="90" height="18" rx="9" fill="rgba(255,255,255,0.15)"/>
  <text x="490" y="435" text-anchor="middle" font-family="system-ui, sans-serif" font-size="10" fill="rgba(255,255,255,0.7)">This week</text>

  <!-- Bottom tagline -->
  <rect x="370" y="510" width="460" height="40" rx="20" fill="rgba(255,255,255,0.06)"/>
  <text x="600" y="535" text-anchor="middle" font-family="system-ui, sans-serif" font-size="14" fill="#667788">A Saturday listicle from lukeocodes.dev</text>

  <!-- Subtitle text -->
  <text x="600" y="585" text-anchor="middle" font-family="system-ui, sans-serif" font-size="13" fill="#556677">Cloudflare Kitesurf  ·  Agent Plugins  ·  OpenAI Astra  ·  ByteDance  ·  Anthropic Chips</text>
</svg>
