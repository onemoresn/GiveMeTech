<text font-family="Excalifont" font-size="13" font-weight="400" fill="#868e96" text-anchor="middle" dominant-baseline="middle"><tspan x="660" y="424">deleted_at + 24 h</tspan></text>
<path d="M141.2 357.6 L580.8 356.6 L578.6 400.2 L138.7 403.6" stroke="none" stroke-width="0" fill="#fff0f0" stroke-linecap="round" stroke-linejoin="round"/>
