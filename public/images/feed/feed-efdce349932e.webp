<text font-family="Excalifont" font-size="13" font-weight="400" fill="#868e96" text-anchor="middle" dominant-baseline="middle"><tspan x="760" y="165.9">fresh_until + 15 min</tspan><tspan x="760" y="182.1">Redis key TTL</tspan></text>
