<text font-family="Excalifont" font-size="16" font-weight="400" fill="#1e1e1e" text-anchor="middle" dominant-baseline="middle"><tspan x="1040" y="96">expires_at</tspan></text>
<text font-family="Excalifont" font-size="13" font-weight="400" fill="#868e96" text-anchor="middle" dominant-baseline="middle"><tspan x="1040" y="174">link's own end</tspan></text>
