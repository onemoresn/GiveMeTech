<text font-family="Excalifont" font-size="16" font-weight="400" fill="#1e1e1e" text-anchor="middle" dominant-baseline="middle"><tspan x="560" y="96">fresh_until</tspan></text>
<text font-family="Excalifont" font-size="13" font-weight="400" fill="#868e96" text-anchor="middle" dominant-baseline="middle"><tspan x="560" y="165.9">now + 24 h</tspan><tspan x="560" y="182.1">(or the link's end)</tspan></text>
<path d="M758.6 115.6 C759 123.2, 760.6 127.9, 758.1 145.9 M760.5 115.6 C759.6 121.1, 760.1 127.4, 759.2 144.5" stroke="#495057" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
