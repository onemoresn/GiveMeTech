# Required for GitHub Actions daily feed updates (Settings → Secrets → Actions).
# Get a free key at https://www.pexels.com/api/
#
# For local runs, copy this file to .env and paste your key:
#   cp .env.example .env
#
# Never commit .env — it is gitignored.
PEXELS_API_KEY=

# Optional: local Gemma 4 e2b summaries via Ollama (ollama pull gemma4:e2b).
# On by default when Ollama is reachable. Set GEMMA_ENABLED=false to skip.
# GitHub Actions has no Ollama — hourly CI falls back to template summaries.
GEMMA_ENABLED=true
GEMMA_MODEL=gemma4:e2b
# OLLAMA_HOST=http://127.0.0.1:11434
# GEMMA_MAX_CALLS=49

# Browser TTS for subscribers (Google AI Studio Gemini TTS)
# Restrict key by HTTP referrer in Google Cloud Console if exposing to the browser.
VITE_GEMINI_API_KEY=

# Optional: SiteCommand deploy/feed webhook (GitHub Actions secret SITECOMMAND_WEBHOOK_URL)
# SITECOMMAND_WEBHOOK_URL=
